# API
API_BEARER_TOKEN=change-me-local-dev-token
API_HOST=127.0.0.1
API_PORT=8000

# Storage (absolute paths recommended)
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./storage/pdf_translation.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Upload limits
MAX_UPLOAD_MB=100
MAX_PAGES=500

# Gemini
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-2.5-pro
GEMINI_UTILITY_MODEL=gemini-2.5-flash

# Translation tuning
CHUNK_TARGET_TOKENS=1500
CHUNK_HARD_CAP_TOKENS=2000
CHUNK_CONTEXT_TOKENS=200
TRANSLATION_CONCURRENCY=5
CHUNK_MAX_RETRIES=2

# Retention (hours). 0 disables auto-purge.
ARTIFACT_RETENTION_HOURS=72

# Extraction
OCR_LANGUAGES=eng
OCR_DPI=200
SCANNED_PAGE_CHAR_THRESHOLD=50
HEADING_SIZE_MULTIPLIER=1.3
CLASSIFICATION_EXCERPT_CHARS=4000
